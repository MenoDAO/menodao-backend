# Environment Configuration
NODE_ENV="development"

# JWT Secret (generate a strong random string for production)
JWT_SECRET="your-jwt-secret-here"

# Cloudflare Turnstile CAPTCHA (https://dash.cloudflare.com/?to=/:account/turnstile)
# Set CAPTCHA_DISABLED=true to skip verification in local development
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
CAPTCHA_DISABLED="false"

# Database Configuration
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"
DB_HOST="your-db-host"
DB_NAME="your-db-name"
DB_USER="your-db-user"
DB_PASSWORD="your-db-password"

# SasaPay Payment API Configuration
SASAPAY_CLIENT_ID="your-sasapay-client-id"
SASAPAY_CLIENT_SECRET="your-sasapay-client-secret"
SASAPAY_MERCHANT_CODE="your-merchant-code"
SASAPAY_BASE_URL="https://sandbox.sasapay.app"
SASAPAY_NETWORK_CODE="63902"

# API Callback URLs (per environment)
API_BASE_URL="https://api.menodao.org"
API_BASE_URL_DEV="https://dev-api.menodao.org"

# SMS Provider Configuration
SMS_PROVIDER_URL="your-sms-provider-url"
SMS_PROVIDER_API_KEY="your-sms-api-key"
SMS_PROVIDER_PARTNER_ID="your-partner-id"
SMS_SENDER_ID="your-sender-id"

# ─── Web3 / Blockchain ────────────────────────────────────────────────────────

# Existing MenoDAOCases contract (case submission)
MENODAO_CONTRACT_ADDRESS="0x..."
BLOCKCHAIN_PRIVATE_KEY="0x..."
CALIBRATION_RPC="https://api.calibration.node.glif.io/rpc/v1"
DEMO_PAYOUT_ETHER="0.001"

# ─── EIP-712 Signed Payouts (MenoDAOClaimVault) ───────────────────────────────
# Generate the Agent Signer wallet OFFLINE:
#   node -e "const {ethers}=require('ethers'); const w=ethers.Wallet.createRandom(); console.log('address:',w.address); console.log('privateKey:',w.privateKey); console.log('mnemonic:',w.mnemonic.phrase);"
# Store the mnemonic in cold storage. Add the private key to your secrets manager.

# Address of the deployed MenoDAOClaimVault contract
CLAIM_VAULT_CONTRACT_ADDRESS="0x..."

# Chain ID where the ClaimVault is deployed (84532 = Base Sepolia, 314159 = Filecoin Calibration)
CLAIM_VAULT_CHAIN_ID="84532"

# Agent Signer private key — signs EIP-712 claims AND pays gas for executePayout
# This wallet does NOT hold payout funds — only gas money (small tFIL)
# HACKATHON SHORTCUT: can equal BLOCKCHAIN_PRIVATE_KEY for demo purposes
# PRODUCTION: MUST be a separate key from BLOCKCHAIN_PRIVATE_KEY
AGENT_SIGNER_PRIVATE_KEY="0x..."

# Agent Signer address — used by the deploy script to configure the ClaimVault
AGENT_SIGNER_ADDRESS="0x..."

# Vision AI verification (optional — falls back to simulation if not set)
VISION_API_KEY=""
VISION_API_ENDPOINT=""

# ─── WhatsApp AI Chatbot (MenoAI) ─────────────────────────────────────────────

# Meta WhatsApp Business API — Cloud API credentials
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_APP_SECRET="your-whatsapp-app-secret"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# OpenAI / LLM configuration
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o"

# ─── Bot monolith (ported from menobot: src/bot/) ──────────────────────────
# BOT_ prefix = bot-only switches; the Meta stack above is unaffected.
BOT_WHATSAPP_PROVIDER="flaresend"
BOT_LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"
# Optional bot-only model overrides (fall back to GEMINI_MODEL/OPENAI_MODEL)
# BOT_GEMINI_MODEL="gemini-2.0-flash"
# BOT_OPENAI_MODEL="gpt-4o-mini"
# Persist full prompts/replies in BotLlmCallLog (PII). Keep false in prod.
BOT_LLM_LOG_PROMPTS="false"
ASSEMBLY_AI_API_KEY="your-assemblyai-api-key"
# Alternate gateways
WABOXAPP_API_TOKEN="your-waboxapp-api-token"
WABOXAPP_PHONE_NUMBER="254712345678"
WABOXAPP_BASE_URL="https://www.waboxapp.com/api"
FLARESEND_API_KEY="your-flaresend-api-key"
FLARESEND_BASE_URL="https://api.flaresend.com"
# FlareSend does not sign webhooks. Put a random token in the endpoint URL:
#   https://<host>/bot/webhook/flaresend/<token>
# Generate with: openssl rand -hex 32
FLARESEND_WEBHOOK_PATH_TOKEN=""
# Optional: reject events addressed to any other instance.
FLARESEND_INSTANCE_ID=""
BOT_BOOKING_TIMEZONE="Africa/Nairobi"
BOT_BOOKING_OPEN_DAYS="1,2,3,4,5,6"
BOT_BOOKING_OPEN_TIME="08:00"
BOT_BOOKING_CLOSE_TIME="17:00"
BOT_BOOKING_SLOT_MINUTES="30"
BOT_BOOKING_DRAFT_TTL_MINUTES="30"
# BOT_WHATSAPP_STATIC_REPLY=""  # kill-switch; leave unset in prod

# Redis session store (leave blank to use in-memory fallback for development)
REDIS_URL="redis://localhost:6379"

# Escalation contacts
WHATSAPP_PARTNER_DENTIST_CONTACT="+254700000000"
WHATSAPP_SUPPORT_EMAIL="support@menodao.org"

# ─── Email (AWS SES) ──────────────────────────────────────────────────────────
# menodao.org is the verified SES identity. The SDK uses the default AWS
# credential chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, ~/.aws/credentials,
# or an instance role). SMTP_* is only needed as a fallback.
AWS_REGION="us-east-1"
SES_FROM="MenoDAO <noreply@menodao.org>"
# SES_DISABLED="true"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="MenoDAO <noreply@menodao.org>"

# ─── WebAuthn / device biometric login (staff, admin, member) ─────────────────
# Relaying party ID must be the registrable domain (no scheme). Origins must
# match the web app. Biometrics stay on the device; we store public keys only.
WEBAUTHN_RP_NAME="MenoDAO"
# Optional override; otherwise CORS_ORIGINS / default app hosts are used.
# WEBAUTHN_ORIGINS="https://app.menodao.org,https://dev.menodao.org,http://localhost:3001"
