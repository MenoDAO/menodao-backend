# Environment Configuration
NODE_ENV="development"

# JWT Secret (generate a strong random string for production)
JWT_SECRET="your-jwt-secret-here"

# Database Configuration
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"
DB_HOST="your-db-host"
DB_NAME="your-db-name"
DB_USER="your-db-user"
DB_PASSWORD="your-db-password"

# SasaPay Payment API Configuration
SASAPAY_CLIENT_ID="your-sasapay-client-id"
SASAPAY_CLIENT_SECRET="your-sasapay-client-secret"
SASAPAY_MERCHANT_CODE="your-merchant-code"
SASAPAY_BASE_URL="https://sandbox.sasapay.app"
SASAPAY_NETWORK_CODE="63902"

# API Callback URLs (per environment)
API_BASE_URL="https://api.menodao.org"
API_BASE_URL_DEV="https://dev-api.menodao.org"

# SMS Provider Configuration
SMS_PROVIDER_URL="your-sms-provider-url"
SMS_PROVIDER_API_KEY="your-sms-api-key"
SMS_PROVIDER_PARTNER_ID="your-partner-id"
SMS_SENDER_ID="your-sender-id"

# ─── Web3 / Blockchain ────────────────────────────────────────────────────────

# Existing MenoDAOCases contract (case submission)
MENODAO_CONTRACT_ADDRESS="0x..."
BLOCKCHAIN_PRIVATE_KEY="0x..."
CALIBRATION_RPC="https://api.calibration.node.glif.io/rpc/v1"
DEMO_PAYOUT_ETHER="0.001"

# ─── EIP-712 Signed Payouts (MenoDAOClaimVault) ───────────────────────────────
# Generate the Agent Signer wallet OFFLINE:
#   node -e "const {ethers}=require('ethers'); const w=ethers.Wallet.createRandom(); console.log('address:',w.address); console.log('privateKey:',w.privateKey); console.log('mnemonic:',w.mnemonic.phrase);"
# Store the mnemonic in cold storage. Add the private key to your secrets manager.

# Address of the deployed MenoDAOClaimVault contract
CLAIM_VAULT_CONTRACT_ADDRESS="0x..."

# Chain ID where the ClaimVault is deployed (84532 = Base Sepolia, 314159 = Filecoin Calibration)
CLAIM_VAULT_CHAIN_ID="84532"

# Agent Signer private key — signs EIP-712 claims AND pays gas for executePayout
# This wallet does NOT hold payout funds — only gas money (small tFIL)
# HACKATHON SHORTCUT: can equal BLOCKCHAIN_PRIVATE_KEY for demo purposes
# PRODUCTION: MUST be a separate key from BLOCKCHAIN_PRIVATE_KEY
AGENT_SIGNER_PRIVATE_KEY="0x..."

# Agent Signer address — used by the deploy script to configure the ClaimVault
AGENT_SIGNER_ADDRESS="0x..."

# Vision AI verification (optional — falls back to simulation if not set)
VISION_API_KEY=""
VISION_API_ENDPOINT=""
