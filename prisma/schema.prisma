// ─── Dependant Model ─────────────────────────────────────────────────────────

model Dependant {
  id           String   @id @default(uuid())
  memberId     String
  fullName     String
  relationship String   // "Parent/Child"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// SMS reminder log for automated renewal reminders (no FK to Member — survives member deletion)
model SmsReminderLog {
  id                String            @id @default(uuid())
  memberId          String
  phoneNumber       String
  templateKey       String
  sentAt            DateTime          @default(now())
  deliveryStatus    ReminderLogStatus
  providerMessageId String?

  @@index([memberId, templateKey, sentAt])
  @@index([sentAt])
}

// ---------------------------------------------------------------------------
// Care Intelligence & Data Room
// Operational DB remains the source of truth for members/visits/treatments.
// These tables are the analytics, AI, experiment, and donor-export layers.
// ---------------------------------------------------------------------------

enum CareEventType {
  MEMBER_REGISTERED
  MEMBERSHIP_VIEWED
  MEMBERSHIP_STARTED
  MEMBERSHIP_PAYMENT_ATTEMPTED
  MEMBERSHIP_PAYMENT_SUCCESS
  MEMBERSHIP_PAYMENT_FAILED
  MEMBERSHIP_CANCELLED
  APPOINTMENT_REQUESTED
  APPOINTMENT_BOOKED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_ATTENDED
  APPOINTMENT_NO_SHOW
  TREATMENT_STARTED
  TREATMENT_COMPLETED
  FOLLOWUP_REQUIRED
  FOLLOWUP_COMPLETED
  REFERRAL_CREATED
  REFERRAL_CONVERTED
  AI_CONVERSATION_STARTED
  AI_INTAKE_COMPLETED
  AI_ESCALATED
  AI_HANDOFF_COMPLETED
}

enum CarePrivacyClass {
  OPERATIONAL
  ANALYTICS
  CLINICAL
  AGGREGATE
}

enum CareInsightKind {
  OBSERVED
  INTERPRETED
  ACTION
}

enum CareInsightStatus {
  OPEN
  ACKNOWLEDGED
  ACTED
  DISMISSED
}

enum CareExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  KILLED
  KEPT
  MODIFIED
}

enum CareAlertSeverity {
  CRITICAL
  WARNING
  OPPORTUNITY
  FOLLOW_UP
}

enum CareRecommendationStatus {
  RECOMMENDED
  VIEWED
  IN_PROGRESS
  DONE
  DISMISSED
}

// Append-only care-loop events. Do not store clinical notes or biometrics.
model CareEvent {
  id              String           @id @default(uuid())
  type            CareEventType
  occurredAt      DateTime         @default(now())
  memberId        String?
  sessionId       String?
  conversationId  String?
  source          String?
  county          String?
  subCounty       String?
  metadata        Json?
  privacyClass    CarePrivacyClass @default(ANALYTICS)
  createdAt       DateTime         @default(now())

  @@index([type, occurredAt])
  @@index([occurredAt])
  @@index([memberId, occurredAt])
  @@index([source])
  @@index([county])
}

// Daily aggregated snapshots so the dashboard does not scan raw tables as data grows.
model CareMetricSnapshot {
  id        String   @id @default(uuid())
  metricId  String
  period    String // day | week | month
  periodStart DateTime
  geography String  @default("ALL")
  value     Float
  sampleSize Int     @default(0)
  metadata  Json?
  createdAt DateTime @default(now())

  @@unique([metricId, period, periodStart, geography])
  @@index([metricId, periodStart])
}

// Admin-configurable conversion and volume targets.
model CareLoopTarget {
  id            String   @id @default(uuid())
  metricId      String   @unique
  targetValue   Float
  minSampleSize Int      @default(10)
  impactWeight  Float    @default(1)
  controllability Float  @default(0.8)
  notes         String?
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

model CareInsight {
  id             String            @id @default(uuid())
  generatedAt    DateTime          @default(now())
  metricId       String
  kind           CareInsightKind
  observation    String
  interpretation String?
  recommendation String?
  evidence       Json
  confidence     String // low | medium | high
  actionTaken    String?
  outcome        String?
  owner          String?
  status         CareInsightStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([generatedAt])
  @@index([metricId])
  @@index([status])
}

model CareExperiment {
  id          String                @id @default(uuid())
  name        String
  hypothesis  String
  metricId    String
  baseline    Float?
  target      Float?
  startDate   DateTime
  endDate     DateTime?
  owner       String?
  status      CareExperimentStatus  @default(DRAFT)
  result      String?
  decision    String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status])
  @@index([metricId])
}

model CareAlert {
  id          String           @id @default(uuid())
  severity    CareAlertSeverity
  title       String
  body        String
  metricId    String?
  cohortKey   String?
  firedAt     DateTime         @default(now())
  resolvedAt  DateTime?
  metadata    Json?

  @@index([firedAt])
  @@index([severity, resolvedAt])
}

model CareRecommendation {
  id              String                   @id @default(uuid())
  problem         String
  evidence        String
  metricId        String
  suggestedAction String
  expectedImpact  String
  confidence      String
  status          CareRecommendationStatus @default(RECOMMENDED)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status])
  @@index([createdAt])
}

model MessageTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  category    String // membership | appointment | followup | referral | satisfaction | payment
  body        String
  approved    Boolean  @default(false)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum FoundationInquiryKind {
  SCHOOL
  VOLUNTEER
  FACILITY
  CONTACT
}

model FoundationInquiry {
  id        String                 @id @default(uuid())
  kind      FoundationInquiryKind
  formId    String
  name      String?
  email     String?
  phone     String?
  summary   String?
  payload   Json
  createdAt DateTime               @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

/// Admin-editable Foundation public site content. A single row keeps the
/// settings previously stored in uploads/foundation/settings.json and the
/// media/copy that powers the refreshed landing page. Stored in Postgres so
/// admin edits survive container replacements and deploys.
model FoundationSiteContent {
  id        String   @id @default("primary")
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── WhatsApp bot (ported from menobot) ─────────────────────────────────────
// Kept separate from Member/Clinic/Appointment. Bot tables hold conversation
// state only; Clinic + Appointment remain the source of truth.

model BotMessageLog {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([createdAt])
}

/// OTP-gated access to a member's own records from WhatsApp. A session is
/// created when a member asks for payments/appointments/visits/claims, then
/// upgraded to VERIFIED for a short window after the SMS code is accepted.
/// The scope is stored so a verification cannot be replayed for other data.
model BotDataAccessSession {
  id            String    @id @default(uuid())
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channel       String    @default("WHATSAPP")
  /// ACCOUNT | PAYMENTS | APPOINTMENTS | VISITS | CLAIMS
  scope         String
  /// PENDING | VERIFIED | EXPIRED | LOCKED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  requestedAt   DateTime  @default(now())
  expiresAt     DateTime
  verifiedUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([memberId, createdAt])
  @@index([status, expiresAt])
  @@index([memberId, status])
}

/// Append-only record of every sensitive-data access attempt, for both members
/// and (later) admins. Deliberately not linked by FK so the trail survives
/// account deletion and cannot be cascaded away.
model SensitiveDataAccessLog {
  id        String   @id @default(uuid())
  /// MEMBER | ADMIN
  actorType String
  actorId   String
  memberId  String?
  /// ACCOUNT | PAYMENTS | APPOINTMENTS | VISITS | CLAIMS | MEMBER_RECORD
  scope     String
  /// WHATSAPP | ADMIN_PORTAL
  channel   String
  /// OTP_SENT | OTP_VERIFIED | GRANTED | DENIED | RATE_LIMITED | LOCKED
  outcome   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([memberId, createdAt])
  @@index([outcome, createdAt])
}

/// An admin's short-lived WhatsApp data-access session. An admin phone can be
/// in member mode or admin mode; this session binds the admin to one member at
/// a time, so switching member always requires a fresh SMS OTP.
model AdminWhatsappSession {
  id            String    @id @default(uuid())
  adminId       String
  adminPhone    String
  memberId      String?
  /// AWAITING_MEMBER | PENDING_OTP | VERIFIED | LOCKED | ENDED
  status        String    @default("AWAITING_MEMBER")
  attempts      Int       @default(0)
  requestedAt   DateTime  @default(now())
  expiresAt     DateTime?
  verifiedUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([adminId, createdAt])
  @@index([adminId, status])
  @@index([status, expiresAt])
}

/// Admin OTP codes are kept separate from member OTPCode rows so a member login
/// can never invalidate an admin second factor (and vice versa).
model AdminOtpCode {
  id          String   @id @default(uuid())
  adminId     String
  phoneNumber String
  code        String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([phoneNumber, code])
}

/// A WhatsApp instance the bot can send from. Mirrors a FlareSend instance and
/// keeps its instance-scoped key encrypted at rest, so an operator can add,
/// switch or relink instances from the dashboard without a redeploy or an SSH
/// session.
model BotWhatsappInstance {
  id              String    @id @default(uuid())
  provider        String    @default("flaresend")
  /// Provider-side identity (FlareSend instance id).
  providerId      String
  label           String?
  phoneNumber     String?
  /// CONNECTED | AWAITING_SCAN | INITIALIZING | DISCONNECTED | UNKNOWN
  status          String    @default("UNKNOWN")
  /// AES-256-GCM ciphertext (v1.iv.tag.ciphertext). Never the plain key.
  apiKeyCipher    String?   @db.Text
  webhookUrl      String?
  /// Exactly one instance per environment sends bot messages.
  isActive        Boolean   @default(false)
  lastCheckedAt   DateTime?
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  threads BotChatThread[]

  @@unique([provider, providerId])
  @@index([isActive])
}

/// One conversation with one WhatsApp contact on one instance.
///
/// This is the compliance-facing record: it carries the retention deadline, the
/// consent basis and the erasure marker, so "how long do we keep this and why"
/// is answerable per conversation rather than per database.
model BotChatThread {
  id             String   @id @default(uuid())
  instanceId     String?
  instance       BotWhatsappInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  memberId       String?
  member         Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// Normalised WhatsApp identity: international digits, or "<id>@lid".
  contactId      String
  contactName    String?
  /// OPEN | CLOSED | ARCHIVED
  status         String   @default("OPEN")
  /// Why we may hold this conversation, e.g. SERVICE_DELIVERY or CONSENT_V1.
  consentBasis   String?
  startedAt      DateTime @default(now())
  lastMessageAt  DateTime @default(now())
  messageCount   Int      @default(0)
  /// The thread and its messages are purged after this instant.
  retentionUntil DateTime
  erasedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages BotChatMessage[]

  @@index([instanceId, lastMessageAt])
  @@index([memberId])
  @@index([contactId])
  @@index([retentionUntil])
}

model BotChatMessage {
  id                String   @id @default(uuid())
  threadId          String
  thread            BotChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// Provider message id, used to spot a retried webhook delivery.
  providerMessageId String?
  /// INBOUND | OUTBOUND
  direction         String
  content           String   @db.Text
  /// TEXT | AUDIO | IMAGE | VIDEO | OTHER
  contentType       String   @default("TEXT")
  /// RECEIVED | SENT | FAILED
  deliveryStatus    String   @default("RECEIVED")
  sentAt            DateTime @default(now())
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([threadId, sentAt])
  @@index([providerMessageId])
}

model BotLead {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  type      String
  notes     String?  @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([memberId])
}

model BotBookingDraft {
  id               String   @id @default(uuid())
  memberId         String   @unique
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  clinicId         String?
  doctorId         String?
  service          String?
  date             String?
  time             String?
  clientName       String?
  rawDateMentioned String?
  language         String   @default("en")
  status           String   @default("COLLECTING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BotOnboardingSession {
  id        String   @id @default(uuid())
  memberId String   @unique
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  step      String   @default("WELCOME")
  language  String   @default("en")
  payload   String   @default("{}") @db.Text
  status    String   @default("IN_PROGRESS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BotContextDocument {
  id        String   @id @default(uuid())
  kind      String   @default("BIBLE")
  title     String?
  content   String   @db.Text
  active    Boolean  @default(true)
  // Where the document came from: MANUAL (written in the admin dashboard),
  // UPLOAD (extracted from a file the admin dropped in the dashboard) or
  // GOOGLE_DRIVE (synced from a Drive file). externalId is the Drive file id
  // for Drive documents and the upload's identity for uploaded ones.
  source      String    @default("MANUAL")
  // Source-document identity: the Drive file id for GOOGLE_DRIVE documents, or
  // a stable derived key for manual imports (so re-importing a guide updates
  // its sections instead of duplicating them).
  externalId  String?
  externalUrl String?
  lastSyncedAt DateTime?
  // Stable identity of a section inside its source document
  // (sha1 of normalised heading + duplicate ordinal).
  sectionKey       String?
  // sha256 of the normalised content; a version only bumps when this changes.
  contentHash      String?
  // Drive revision id / checksum of the source file at last sync.
  externalRevision String?
  // Drive modifiedTime of the source file at last sync.
  sourceModifiedAt DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Set when this section was produced by extracting an uploaded file; traces
  // the retrievable text back to the raw bytes held in S3.
  fileId String?
  file   BotContextFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  versions BrandContextDocumentVersion[]

  @@unique([source, externalId, sectionKey])
  @@index([kind, active])
  @@index([source, externalId])
  @@index([fileId])
}

/**
 * A file the admin uploaded to the brand context library.
 *
 * The original bytes are stored untouched in S3 (`raw/…`), and the extracted,
 * retrieval-friendly text is stored beside them (`text/…`) so re-processing a
 * guide never has to re-run the expensive PDF/DOCX extraction. The sections
 * that actually feed retrieval live on BotContextDocument, keyed back to this
 * row through `fileId`.
 */
model BotContextFile {
  id        String @id @default(uuid())
  filename  String
  // Original mime type reported by the browser, kept for diagnostics only:
  // the extension decides how the bytes are parsed.
  contentType String
  byteSize    Int
  sha256      String
  // Stable identity of the effective title + extracted text. Two uploads with
  // the same title and content collapse onto one row even if the source bytes
  // differ (PDF vs DOCX re-export, metadata-only changes).
  dedupeKey   String? @unique
  // S3 key of the untouched original: raw/<sha256>/<filename>
  storageKey  String
  // S3 key of the extracted markdown: text/<sha256>/<filename>.md
  textStorageKey String?
  // UPLOADED | EXTRACTED | FAILED
  status      String   @default("UPLOADED")
  // Why extraction failed (unsupported type, no extractable text, corrupt).
  extractError String?
  extractedAt DateTime?
  // How many retrievable sections this upload produced.
  sectionCount Int     @default(0)
  // Defaults applied to every section the file produced.
  kind        String   @default("BIBLE")
  title       String?
  uploadedByAdminId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents BotContextDocument[]

  @@index([sha256])
  @@index([status])
  @@index([createdAt])
}

model BrandContextDocumentVersion {
  id               String   @id @default(uuid())
  documentId       String
  document         BotContextDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version          Int
  kind             String
  title            String?
  content          String   @db.Text
  contentHash      String
  source           String
  externalRevision String?
  // CREATE | UPDATE | SYNC | ROLLBACK | DELETE
  changeType       String
  createdByAdminId String?
  createdAt        DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model BotLlmCallLog {
  id             String   @id @default(uuid())
  memberId       String?
  member         Member?  @relation(fields: [memberId], references: [id])
  provider       String
  model          String
  operation      String
  responseFormat String?
  systemPrompt   String   @db.Text
  userPrompt     String   @db.Text
  history        String   @db.Text
  response       String?  @db.Text
  status         String
  error          String?  @db.Text
  durationMs     Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([memberId])
  @@index([status, createdAt])
  @@index([operation, createdAt])
}
