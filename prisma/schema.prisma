// MenoDAO Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Member/User model
model Member {
  id             String   @id @default(uuid())
  phoneNumber    String   @unique
  fullName       String?
  location       String?
  walletAddress  String?  @unique
  isVerified     Boolean  @default(false)
  branch         String?
  subCounty      String?
  county         String?
  preferredChain    String?  @default("celo")
  preferredLanguage String?  @default("en")
  // WhatsApp bot link: set on first inbound message when the phone matches
  // an existing member — no separate bot signup is required for known numbers.
  whatsappId      String?  @unique
  whatsappLinkedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Champion Referral System fields
  referralCode         String?  @unique
  referredBy           String?  // Referral code of the champion who referred this member
  firstPaymentCleared  Boolean  @default(false)
  commissionsBalance   Int      @default(0) // KES, whole shillings
  commissionsWithdrawn Int      @default(0) // KES, total withdrawn to date
  activeReferralsCount Int      @default(0)
  isGoldMember         Boolean  @default(false)

  // Relations
  subscription      Subscription?
  contributions     Contribution[]
  claims            Claim[]
  nfts              NFT[]
  otpCodes          OTPCode[]
  transactions      BlockchainTransaction[]
  deviceTokens      DeviceToken[]
  visits            Visit[]
  appointments      Appointment[]
  campRegistrations CampRegistration[]
  webauthnCredentials WebAuthnCredential[]
  commissionLedger  CommissionLedger[]
  withdrawalRecords WithdrawalRecord[]
  dependants        Dependant[]
  botMessages       BotMessageLog[]
  botLeads          BotLead[]
  botBookingDraft   BotBookingDraft?
  botOnboardingSessions BotOnboardingSession[]
  botLlmLogs        BotLlmCallLog[]
  botChatThreads    BotChatThread[]
  botDataAccessSessions BotDataAccessSession[]

  @@index([referralCode])
  @@index([referredBy])
  @@index([subCounty])
  @@index([county])
  @@index([createdAt])
}

// OTP codes for SMS authentication
model OTPCode {
  id          String   @id @default(uuid())
  code        String
  phoneNumber String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  /// Failed verification attempts. The code is burned after 5 wrong guesses.
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  member   Member? @relation(fields: [memberId], references: [id])
  memberId String?

  @@index([phoneNumber, code])
}

// Package tiers
enum PackageTier {
  BRONZE
  SILVER
  GOLD
}

// Payment frequency enum
enum PaymentFrequency {
  MONTHLY
  ANNUAL
}

// Member subscription
model Subscription {
  id                    String           @id @default(uuid())
  tier                  PackageTier
  monthlyAmount         Int // Amount in KES
  paymentFrequency      PaymentFrequency @default(MONTHLY)
  subscriptionStartDate DateTime         @default(now()) // For waiting period calculation
  startDate             DateTime         @default(now())
  endDate               DateTime?
  isActive              Boolean          @default(false) // Default inactive until payment
  annualCapUsed         Int              @default(0) // Tracks spending against annual cap
  annualCapLimit        Int              @default(6000) // 6k, 10k, or 15k based on tier
  procedureUsageCount   Json             @default("{}") // Tracks procedure frequency per year
  lastResetDate         DateTime         @default(now()) // Last annual reset date
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  member   Member @relation(fields: [memberId], references: [id])
  memberId String @unique

  @@index([subscriptionStartDate])
  @@index([paymentFrequency])
}

// Contribution/Payment record
model Contribution {
  id                    String           @id @default(uuid())
  amount                Int // Amount in KES
  month                 DateTime // The month this contribution covers
  paymentMethod         String // mpesa, card, crypto
  paymentRef            String? // External payment reference (menodao_xxxxx)
  txHash                String? // Blockchain transaction hash
  status                PaymentStatus    @default(PENDING)
  paymentFrequency      PaymentFrequency @default(MONTHLY)
  claimLimitsAssigned   Boolean          @default(false)
  claimLimitsAssignedAt DateTime?
  confirmedAt           DateTime?
  metadata              Json? // Payment provider response data
  
  // SasaPay fields
  merchantRequestId     String?
  checkoutRequestId     String?
  mpesaReceiptNumber    String?
  
  // URLs
  callbackUrl           String?
  redirectUrl           String?
  
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  member   Member @relation(fields: [memberId], references: [id])
  memberId String

  @@index([memberId, month])
  @@index([paymentRef])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Claim/Treatment record
model Claim {
  id              String      @id @default(uuid())
  claimType       ClaimType
  description     String
  amount          Int // Amount in KES
  status          ClaimStatus @default(PENDING)
  rejectionReason String? // Reason provided by staff when rejecting
  txHash          String? // Blockchain transaction hash for disbursement
  campId          String?
  visitId         String? // Link to visit if created from staff dashboard
  processedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  member     Member      @relation(fields: [memberId], references: [id])
  memberId   String
  camp       Camp?       @relation(fields: [campId], references: [id])
  visit      Visit?      @relation(fields: [visitId], references: [id])
  disbursal  Disbursal?
}

enum ClaimType {
  DENTAL_CHECKUP
  DENTAL_CLEANING
  DENTAL_FILLING
  DENTAL_EXTRACTION
  ROOT_CANAL
  OTHER
}

enum ClaimStatus {
  PENDING
  APPROVED
  PROCESSING
  DISBURSED
  REJECTED
}

// Disbursal status enum
enum DisbursalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

// Payment channel enum
enum PaymentChannel {
  MPESA_TILL
  MPESA_PAYBILL
  MPESA_MOBILE
  BANK_TRANSFER
}

// Disbursal record for clinic payments
model Disbursal {
  id                   String          @id @default(uuid())
  claimId              String          @unique
  clinicId             String
  amount               Int // Amount in KES
  status               DisbursalStatus @default(PENDING)
  paymentChannel       PaymentChannel
  transactionReference String          @unique
  recipientIdentifier  String // Till/Paybill/Mobile/Account number

  // SasaPay fields
  sasaPayRequestId     String?
  sasaPayCheckoutId    String?
  mpesaReceiptNumber   String?

  errorMessage         String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  completedAt          DateTime?
  reversedAt           DateTime?
  reversalReason       String?

  claim                Claim                    @relation(fields: [claimId], references: [id])
  clinic               Clinic                   @relation(fields: [clinicId], references: [id])
  statusHistory        DisbursalStatusHistory[]

  @@index([claimId])
  @@index([clinicId])
  @@index([status])
  @@index([createdAt])
}

// Disbursal status history for audit trail
model DisbursalStatusHistory {
  id          String          @id @default(uuid())
  disbursalId String
  status      DisbursalStatus
  timestamp   DateTime        @default(now())
  metadata    Json?

  disbursal Disbursal @relation(fields: [disbursalId], references: [id])

  @@index([disbursalId])
  @@index([timestamp])
}

// NFT minted for members
model NFT {
  id              String      @id @default(uuid())
  tokenId         String      @unique
  tier            PackageTier
  contractAddress String
  txHash          String
  mintedAt        DateTime    @default(now())
  metadata        Json?

  member   Member @relation(fields: [memberId], references: [id])
  memberId String
}

// Dental camps
model Camp {
  id          String   @id @default(uuid())
  name        String
  description String?
  venue       String
  address     String
  latitude    Float
  longitude   Float
  startDate   DateTime
  endDate     DateTime
  capacity    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  claims        Claim[]
  registrations CampRegistration[]
}

// Camp registrations
model CampRegistration {
  id        String             @id @default(uuid())
  status    RegistrationStatus @default(REGISTERED)
  createdAt DateTime           @default(now())

  campId   String
  memberId String
  camp     Camp   @relation(fields: [campId], references: [id])
  member   Member @relation(fields: [memberId], references: [id])

  @@unique([campId, memberId])
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  NO_SHOW
  CANCELLED
}

// Blockchain transaction log for auditability
model BlockchainTransaction {
  id          String          @id @default(uuid())
  txHash      String          @unique
  txType      TransactionType
  fromAddress String
  toAddress   String
  amount      String? // In wei or token units
  tokenId     String? // For NFT transactions
  network     String          @default("polygon")
  status      TxStatus        @default(PENDING)
  blockNumber Int?
  gasUsed     String?
  createdAt   DateTime        @default(now())
  confirmedAt DateTime?

  member   Member? @relation(fields: [memberId], references: [id])
  memberId String?
}

enum TransactionType {
  NFT_MINT
  CONTRIBUTION
  CLAIM_DISBURSEMENT
  UPGRADE
}

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
}

// Admin role enum
enum AdminRole {
  SUPER_ADMIN
  JUNIOR_ADMIN
  CUSTOMER_SERVICE
}

// Admin user for dashboard access
model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         AdminRole @default(SUPER_ADMIN)
  phoneNumber  String?   @unique
  isActive     Boolean   @default(true)
  // One-time invite/reset flow: the plaintext token is shown only once at
  // creation, the hash is stored here. Accepting the invite sets the password.
  mustChangePassword Boolean  @default(false)
  inviteTokenHash    String?
  inviteExpiresAt    DateTime?
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notifications Notification[]
  auditLogs     AuditLog[]
  webauthnCredentials WebAuthnCredential[]
}

// Audit log for admin actions
model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String // PAYMENT, MEMBER, SUBSCRIPTION, DISBURSAL
  targetId   String
  reason     String
  metadata   Json?
  timestamp  DateTime @default(now())
  ipAddress  String

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([timestamp])
}

// Staff user for clinic/camp staff access
model StaffUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  fullName     String
  role         StaffRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  branch       String?
  clinicId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  visits        Visit[]
  appointments  Appointment[]
  clinic        Clinic? @relation(fields: [clinicId], references: [id])
  webauthnCredentials WebAuthnCredential[]
}

enum StaffRole {
  STAFF // Can check-in and add claims
  ADMIN // Can override limits and void claims
}

// Device passkeys for staff/admin login. Public keys only — never store biometrics.
model WebAuthnCredential {
  id           String   @id @default(uuid())
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String[] @default([])
  label        String?
  staffUserId  String?
  adminUserId  String?
  memberId     String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  member    Member?    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@index([adminUserId])
  @@index([memberId])
}

model WebAuthnChallenge {
  id        String   @id @default(uuid())
  kind      String
  type      String
  userId    String?
  username  String   @default("")
  challenge String
  origin    String
  rpId      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([kind, type, username])
  @@index([expiresAt])
}

// Patient visit record
model Visit {
  id           String      @id @default(uuid())
  memberId     String
  staffId      String // Staff who checked in the patient
  status       VisitStatus @default(OPEN)
  totalCost    Int         @default(0) // Total cost of procedures in KES
  checkedInAt  DateTime    @default(now())
  dischargedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Web3 / Filecoin / Hypercert fields (optional overlay)
  beforeCID              String?  // Filecoin CID for before image
  afterCID               String?  // Filecoin CID for after image
  web3VerificationStatus String   @default("NONE") // NONE | PENDING | VERIFIED | REJECTED
  caseOnChainId          Int?     // Smart contract case ID
  onChainTxHash          String?  // Tx hash from contract submitCase
  payoutTxHash           String?  // Tx hash from contract approveAndPay
  hypercertData          Json?    // Hypercert metadata + mock mint result
  aiVerificationResult   Json?    // AI verifier output { verified, confidence }

  member        Member             @relation(fields: [memberId], references: [id])
  staff         StaffUser          @relation(fields: [staffId], references: [id])
  procedures    VisitProcedure[]
  claims        Claim[]
  questionnaire QuestionnaireData? // CDCQ-v1 data
  appointment   Appointment?

  // Clinical data for SACCO/Insurance and data privacy compliance
  chiefComplaint String?
  medicalHistory String?
  vitals         Json? // { bp: string, pulse: number, temp: number }
  clinicalNotes  String?
  hasConsent     Boolean @default(false)

  @@index([memberId])
  @@index([staffId])
  @@index([status])
  @@index([checkedInAt])
  @@index([dischargedAt])
}

// Comprehensive Dental Check-Up Questionnaire (CDCQ-v1)
model QuestionnaireData {
  id      String @id @default(uuid())
  visitId String @unique

  // Section 1: Demographics & Consent
  dateOfVisit      DateTime @default(now())
  age              Int?
  gender           String? // Male, Female, Non-binary/Other, Prefer not to say
  education        String? // Primary, Secondary, Trade, University, None
  occupation       String?
  residenceVillage String?
  residenceCounty  String?
  researchConsent  Boolean  @default(false)

  // Section 2: Medical & Dental History
  lastDentalVisit    String? // <6mo, 6-12mo, 1-2yr, >2yr, Never
  drugAllergies      String? // List of allergies or "None"
  currentMedications String? // List of medications or "None"
  medicalConditions  Json? // Array: ["Diabetes", "Hypertension", etc.]
  familyHistory      Json? // Array: ["Periodontitis", "Tooth Decay", etc.]

  // Section 3: Current Dental Concerns
  chiefComplaint String? // Routine, Pain, Broken tooth, etc.
  painLevel      Int? // 0-10 scale
  recentSymptoms Json? // Array: ["Sensitivity", "Pain when chewing", etc.]

  // Section 4: Oral Hygiene & Lifestyle
  brushingFrequency String? // Twice daily, Once daily, Occasionally, Never
  flossingFrequency String? // Daily, Weekly, Rarely/Never
  sugarIntake       String? // High (3+/day), Moderate (1-2/day), Low (occasional)
  smokesTobacco     Boolean @default(false)
  alcoholUse        String? // Frequent, Occasional, Never
  substanceUse      Boolean @default(false) // Khat/Miraa

  // Section 5: Clinical Examination (Clinician)
  oralHygieneIndex   String? // Good, Fair, Poor
  softTissueFindings String? // WNL or description
  periodontalStatus  String? // BPE score: 0-4
  decayedTeeth       Int? // D count
  missingTeeth       Int? // M count
  filledTeeth        Int? // F count
  dmftScore          Int? // D+M+F total
  occlusionStatus    String? // Normal Class I, Malocclusion, TMJ Issues

  // Section 6: Risk Assessment (Clinician)
  cariesRisk      String? // Low, Moderate, High
  periodontalRisk String? // Low, Moderate, High
  oralCancerRisk  String? // Low, Elevated

  // Section 7: Patient Satisfaction
  smileSatisfaction String? // Very Satisfied, Somewhat Satisfied, Dissatisfied
  careConfidence    String? // Very Confident, Somewhat Confident, Not Confident

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([dateOfVisit])
}

enum VisitStatus {
  OPEN // Patient checked in, treatment in progress
  DISCHARGED // Visit completed and closed
  CANCELLED // Visit cancelled
}

// Dental procedure definitions
model Procedure {
  id              String   @id @default(uuid())
  code            String   @unique // e.g., "CONSULT", "EXTRACT_SIMPLE"
  name            String // e.g., "Consultation", "Simple Extraction"
  description     String?
  cost            Int // Cost in KES
  allowedTiers    Json // Array of PackageTier values: ["BRONZE", "SILVER", "GOLD"]
  durationMinutes Int      @default(15) // expected chair time; booking uses this when set
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  visitProcedures VisitProcedure[]
}

// Join table: Visit-Procedure relationship
model VisitProcedure {
  id          String   @id @default(uuid())
  visitId     String
  procedureId String
  cost        Int // Cost at time of procedure (in case prices change)
  addedAt     DateTime @default(now())
  addedBy     String // Staff ID who added the procedure

  visit     Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id])

  @@index([visitId])
  @@index([procedureId])
}

// Device tokens for push notifications
model DeviceToken {
  id        String   @id @default(uuid())
  memberId  String
  token     String   @unique
  platform  String // 'web' | 'android' | 'ios'
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// Admin notification system
model Notification {
  id             String             @id @default(uuid())
  type           NotificationType
  recipientCount Int
  message        String             @db.Text // Sanitized content
  status         NotificationStatus @default(PENDING)
  successCount   Int                @default(0)
  failureCount   Int                @default(0)
  sentAt         DateTime           @default(now())
  sentBy         String // Admin user ID
  sentByAdmin    AdminUser          @relation(fields: [sentBy], references: [id])

  // Filter criteria used (for audit trail)
  filterCriteria Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, sentAt])
  @@index([sentBy])
  @@index([status])
}

enum NotificationType {
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  PARTIAL // Some delivered, some failed
}

// SMS log for tracking sent messages
model SmsLog {
  id           String    @id @default(uuid())
  phoneNumber  String
  message      String
  status       SmsStatus @default(PENDING)
  provider     String    @default("textsms")
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([phoneNumber])
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
}

enum ReminderLogStatus {
  SENT
  FAILED
}

// Site visit tracking for landing page analytics
model SiteVisit {
  id          String   @id @default(uuid())
  page        String // URL path visited
  referrer    String? // HTTP referrer
  utmSource   String? // utm_source param
  utmMedium   String? // utm_medium param
  utmCampaign String? // utm_campaign param
  userAgent   String?
  ip          String? // Hashed for privacy
  sessionId   String? // Client-side session ID to group visits
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([utmSource])
  @@index([sessionId])
}

// Clinic registration status
enum ClinicStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

// X-Ray capability
enum XRayCapability {
  NONE
  PERIAPICAL
  OPG
}

// Partner clinic model
model Clinic {
  id                     String         @id @default(uuid())
  // Section 1: Clinic Details
  name                   String
  subCounty              String
  physicalLocation       String
  googleMapsLink         String?
  operatingHours         String
  operatesOnWeekends     Boolean        @default(false)
  // Section 2: Contacts
  leadDentistName        String
  ownerPhone             String
  managerName            String?
  whatsappNumber         String
  email                  String?
  // Section 3: Payment & Settlement
  mpesaTillOrPaybill     String
  tillPaybillName        String
  bankAccountName        String?
  bankAccountNumber      String?
  // Section 4: Capacity & Compliance
  kmpdcRegNumber         String? // Required for NEW clinics (enforced via validation)
  activeDentalChairs     Int            @default(1)
  xrayCapability         XRayCapability @default(NONE)
  specializedServices    Json? // ["ORTHODONTIST", "MAXILLOFACIAL", "PEDIATRIC"]
  // Section 5: Agreement
  agreedToRateCard       Boolean        @default(false)
  agreedToNoChargePolicy Boolean        @default(false)
  // Admin fields
  status                 ClinicStatus   @default(PENDING)
  rejectionReason        String?
  approvedAt             DateTime?
  approvedBy             String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  // Geo fields
  latitude               Float?
  longitude              Float?
  // Branch fields
  parentClinicId         String?
  branchName             String?
  // Relations
  staffUsers             StaffUser[]
  disbursals             Disbursal[]
  paymentConfig          ClinicPaymentConfig?
  appointments           Appointment[]
  doctors                ClinicDoctor[]
  operatingSchedule      ClinicOperatingHour[]
  parentClinic           Clinic?  @relation("ClinicBranches", fields: [parentClinicId], references: [id])
  branches               Clinic[] @relation("ClinicBranches")

  @@index([status])
  @@index([subCounty])
  @@index([parentClinicId])
}

// Clinic payment configuration for disbursals
model ClinicPaymentConfig {
  id                String         @id @default(uuid())
  clinicId          String         @unique
  paymentChannel    PaymentChannel

  // M-Pesa fields
  tillNumber        String?
  paybillNumber     String?
  mobileNumber      String?

  // Bank fields
  bankAccountNumber String?
  bankName          String?
  bankBranchCode    String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
}

enum AppointmentStatus {
  BOOKED
  RESCHEDULED
  CANCELLED_BY_MEMBER
  CANCELLED_BY_CLINIC
  ATTENDED
  NO_SHOW
}

enum AppointmentActor {
  MEMBER
  STAFF
  SYSTEM
}

enum AppointmentReminderKind {
  DAY_BEFORE
  HOUR_BEFORE
}

enum AppointmentChannel {
  SMS
  EMAIL
}

model Appointment {
  id                         String            @id @default(uuid())
  memberId                   String
  clinicId                   String
  staffId                    String?
  doctorId                   String?
  visitId                    String?           @unique
  scheduledAt                DateTime
  durationMinutes            Int               @default(20)
  status                     AppointmentStatus @default(BOOKED)
  intakeReason               String
  painLevel                  Int?
  allergies                  String?
  currentMedications         String?
  medicalConditions          String?
  hasConsent                 Boolean           @default(false)
  memberNotes                String?
  clinicNotes                String?
  cancelReason               String?
  rescheduleReason           String?
  dayBeforeReminderSentAt    DateTime?
  hourBeforeReminderSentAt   DateTime?
  noShowNotedAt              DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  member    Member              @relation(fields: [memberId], references: [id])
  clinic    Clinic              @relation(fields: [clinicId], references: [id])
  staff     StaffUser?          @relation(fields: [staffId], references: [id])
  doctor    ClinicDoctor?       @relation(fields: [doctorId], references: [id])
  visit     Visit?              @relation(fields: [visitId], references: [id])
  events    AppointmentEvent[]
  reminders AppointmentReminder[]

  /// External calendar the appointment was pushed to (GOOGLE | MICROSOFT).
  /// Populated by the calendar sync layer once a doctor/clinic is connected.
  externalCalendarProvider String?     @default("NONE")
  externalEventId          String?
  calendarSyncedAt         DateTime?

  @@index([memberId, scheduledAt])
  @@index([clinicId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([staffId])
  @@index([doctorId, scheduledAt])
}

model AppointmentEvent {
  id               String           @id @default(uuid())
  appointmentId    String
  type             String
  actor            AppointmentActor
  actorId          String?
  reason           String?
  fromScheduledAt  DateTime?
  toScheduledAt    DateTime?
  metadata         Json?
  createdAt        DateTime         @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

model AppointmentReminder {
  id            String                  @id @default(uuid())
  appointmentId String
  kind          AppointmentReminderKind
  channel       AppointmentChannel
  recipient     String
  status        String
  errorMessage  String?
  sentAt        DateTime                @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, kind, channel])
  @@index([appointmentId])
}

// ─── Booking: doctors, schedules, calendar sync ─────────────────────────────

model ClinicDoctor {
  id                  String   @id @default(uuid())
  clinicId            String
  name                String
  title               String? // e.g. "Dr.", "DDS"
  specialty           String?
  isActive            Boolean  @default(true)
  consultationMinutes Int      @default(15)
  bufferMinutes       Int      @default(5)
  timezone            String? // defaults to clinic/BOT_BOOKING_TIMEZONE when null
  // External calendar (Google Calendar / MS365 / etc.) — future sync
  calendarProvider    String? // GOOGLE | MICROSOFT | NONE
  calendarId          String?
  calendarSyncToken   String?  @db.Text
  calendarConnectedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinic       Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  availability DoctorAvailability[]
  appointments Appointment[]

  @@index([clinicId, isActive])
}

model DoctorAvailability {
  id        String   @id @default(uuid())
  doctorId  String
  dayOfWeek Int      // 0=Sunday ... 6=Saturday (JS/Date.getDay convention)
  startTime String   // "HH:mm" 24h local
  endTime   String   // "HH:mm" 24h local
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor ClinicDoctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek, isActive])
}

model ClinicOperatingHour {
  id        String   @id @default(uuid())
  clinicId  String
  dayOfWeek Int      // 0=Sunday ... 6=Saturday
  openTime  String?  // "HH:mm"; null when isClosed
  closeTime String?  // "HH:mm"; null when isClosed
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@index([clinicId])
}

/// OAuth2 token connection to an external calendar for a clinic or a single
/// doctor (Google Calendar / Microsoft 365). Tokens are stored encrypted at
/// rest; plaintext API keys only live in env and are never persisted.
model CalendarConnection {
  id               String   @id @default(uuid())
  /// "DOCTOR" or "CLINIC"
  ownerType        String
  ownerId          String
  provider         String // "GOOGLE" | "MICROSOFT"
  calendarId       String?
  accountEmail    String?
  accessToken      String   @db.Text
  refreshToken     String?  @db.Text
  tokenExpiresAt   DateTime?
  scopes           String?  @db.Text
  connectedAt      DateTime @default(now())
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([ownerType, ownerId, provider])
  @@index([ownerType, ownerId])
}

// ─── Champion Referral System ────────────────────────────────────────────────

enum WithdrawalStatus {
  PENDING
  PENDING_ADMIN_APPROVAL
  APPROVED
  REJECTED
  FAILED
  COMPLETED
}

// Commission ledger — one entry per referred user's first payment
model CommissionLedger {
  id             String      @id @default(uuid())
  championId     String
  referredUserId String
  contributionId String
  amount         Int         // Commission amount in KES
  tier           PackageTier // Tier of referred user at time of commission
  createdAt      DateTime    @default(now())

  champion       Member      @relation(fields: [championId], references: [id])

  @@index([championId])
  @@index([createdAt])
}

// Withdrawal requests for champion commission payouts
model WithdrawalRecord {
  id                 String           @id @default(uuid())
  championId         String
  amount             Int              // Withdrawal amount in KES
  status             WithdrawalStatus @default(PENDING)
  sasaPayRequestId   String?
  mpesaReceiptNumber String?
  errorMessage       String?
  rejectionReason    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  approvedAt         DateTime?
  completedAt        DateTime?

  champion           Member           @relation(fields: [championId], references: [id])

  @@index([championId])
  @@index([status])
  @@index([createdAt])
